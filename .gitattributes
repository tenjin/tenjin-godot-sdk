# Auto-detect text files and normalize them to LF
* text=auto

# Godot and build scripts must stay LF on every platform
*.gd        text eol=lf
*.cfg       text eol=lf
*.tscn      text eol=lf
*.godot     text eol=lf
*.gdextension text eol=lf
*.sh        text eol=lf
gradlew     text eol=lf
*.bat       text eol=crlf

# Native binaries (normally built, not committed) and images: never normalize
*.xcframework/** binary
*.framework/**   binary
*.a              binary
*.so             binary
*.dll            binary
*.dylib          binary
*.aar            binary
*.jar            binary
*.png            binary
*.jpg            binary
